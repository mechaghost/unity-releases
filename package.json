{
  "name": "unity-releases",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "tsx tests/db/core-upsert-db-contract.ts && tsx tests/product-updates/db-contract.ts",
    "e2e:serve": "tsx tests/e2e/setup-db.ts && next build && next start --port 3100",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/jobs/migrate.ts",
    "ingest:backfill": "tsx src/jobs/backfill-unity6.ts",
    "ingest:editor": "tsx src/jobs/poll-editor.ts",
    "ingest:legacy-lts": "tsx src/jobs/poll-legacy-lts.ts",
    "ingest:packages": "tsx src/jobs/poll-packages.ts",
    "ingest:package-docs": "tsx src/jobs/poll-package-docs.ts",
    "ingest:news": "tsx src/jobs/poll-news.ts",
    "ingest:resources": "tsx src/jobs/poll-resources.ts",
    "ingest:discussions": "tsx src/jobs/poll-discussions.ts",
    "ingest:github": "tsx src/jobs/poll-github.ts",
    "ingest:product-update": "tsx src/jobs/poll-product-update.ts",
    "ingest:product-updates": "tsx src/jobs/poll-product-update-group.ts",
    "product-updates:sources": "tsx src/jobs/list-product-update-sources.ts",
    "ingest:all": "tsx src/jobs/poll-all.ts",
    "health:ingest": "tsx src/jobs/health.ts",
    "repair:core-projections": "tsx src/jobs/refresh-core-projections.ts",
    "check:packages": "tsx src/jobs/check-missing-packages.ts",
    "check:lts": "tsx src/jobs/check-lts-lines.ts"
  },
  "dependencies": {
    "@radix-ui/react-hover-card": "^1.1.15",
    "@types/pg": "^8.11.11",
    "@visx/axis": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.2.5",
    "next": "^15.3.2",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "overrides": {
    "esbuild": "0.27.2",
    "postcss": "8.5.24",
    "sharp": "0.35.0"
  }
}
